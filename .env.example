# Copy to .env.local and fill in. Never commit the real file.
#
# Supabase project: jxiimmdduhhhtxnbemih
# Both strings are on the Supabase dashboard under Project Settings > Database.

# ─── App runtime ─────────────────────────────────────────────────────────────
# The POOLED connection (Supavisor, port 6543), transaction mode.
# Every serverless invocation opens its own connection; without the pooler you
# exhaust Postgres exactly when a merchant is having an outage and traffic spikes.
DATABASE_URL="postgresql://postgres.jxiimmdduhhhtxnbemih:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# ─── Migrations only ─────────────────────────────────────────────────────────
# The DIRECT connection (port 5432). Supavisor's transaction mode cannot hold
# the session state that DDL and advisory locks need, so migrations must not go
# through the pooler.
DIRECT_DATABASE_URL="postgresql://postgres.jxiimmdduhhhtxnbemih:[YOUR-DB-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─── Concurrency proofs ──────────────────────────────────────────────────────
# Point at a SCRATCH database. The suite creates its own schema and drops it,
# but never aim it at production. Use the DIRECT (5432) string — advisory locks
# are session-scoped and invisible through a transaction-mode pooler.
TEST_DATABASE_URL=""

# ─── Secrets ─────────────────────────────────────────────────────────────────
# 32+ bytes. Encrypts Razorpay key secrets and webhook secrets before they are
# written to the database. No card data is ever stored — under the RBI
# tokenisation mandate we hold Razorpay tokens, never PANs.
ENCRYPTION_KEY=""

NODE_ENV="development"

# ─── Razorpay ────────────────────────────────────────────────────────────────
# Dashboard > Account & Settings > API Keys. Use a TEST key while building —
# scripts/capture-fixtures.ts refuses to run against live mode, because it
# writes payloads into files that get committed.
RAZORPAY_API_KEY="rzp_test_xxxxxxxxxxxx"
RAZORPAY_API_SECRET=""

# Dashboard > Settings > Webhooks. Razorpay signs every delivery with this.
# Without it the endpoint is open: anyone who learns the URL can post fake
# payment failures and drive real messages to real customers.
RAZORPAY_WEBHOOK_SECRET=""
